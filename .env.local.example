# .env.local - Frontend Environment Configuration

# 🔗 Backend API Configuration (Vite requires VITE_ prefix for client exposure)
VITE_API_URL=https://localhost:7008/api

# ⏱️ API Request Timeout (in milliseconds)
# Adjust if your API is slow or you have intermittent connectivity
VITE_API_TIMEOUT=10000

# 🌍 Environment Name
VITE_ENV=development

# 🔍 Enable API Request Logging
# Set to 'true' to see all API calls in browser console
VITE_LOG_REQUESTS=true

# 🐛 Enable Debug Mode
# Additional debugging information in console
VITE_DEBUG_MODE=false

# 📦 Application Name (optional)
VITE_NAME=SLA Sentinel

# 📝 Notes:
# - This file is NOT committed to Git (see .gitignore)
# - Create one for each environment (dev, staging, production)
# - Restart npm run dev after changes
# - Never put secrets or API keys here in production
